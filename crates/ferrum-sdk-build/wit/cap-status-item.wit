package ferrum:plugin@1.0.0;

// CAPABILITY. Grant name: "status-item".

/// A small persistent reading in the window's chrome.
///
/// **This is not a UI surface either, and the same rule applies.** The plugin
/// supplies a label, an optional fraction and an optional line of detail. The
/// host decides the slot, the size, the typeface, the colours and whether to
/// show it at all. No geometry, no colour, no layout, no handle to anything
/// drawn — a guest cannot place a pixel, cannot overlap the editor, and cannot
/// make its item bigger than the host wants it.
///
/// It is deliberately *narrower* than the reserved `cap-panels`, and it is not
/// a first instalment of it. `notify` is the seam for things that interrupt;
/// this is the seam for a number somebody wants to be able to glance at. The
/// vocabulary is fixed at what a glanceable reading needs — a name, a
/// proportion, a word of context — because a vocabulary that grows one field
/// at a time is how a constrained widget becomes an unconstrained one.
///
/// The motivating case is a usage meter: how much of a quota is spent and when
/// it resets. That is a label, a fraction and a line of detail, and everything
/// beyond it is a panel.
interface status-item {
  use types.{command-id, host-error};

  /// Where the host is willing to put one.
  ///
  /// A closed enum rather than coordinates. Slots are the host's layout
  /// vocabulary; a plugin naming a pixel would break the moment the window
  /// changed, and a plugin naming *another plugin's* pixel is a fight the host
  /// would have to referee.
  enum slot {
    /// The foot of the activity rail, under the last icon. Narrow: expect
    /// room for a very short label and a bar, and nothing else.
    rail-foot,
    /// The trailing end of the status bar. Wider, and shared with the host's
    /// own readings, so the host may abbreviate or drop it under pressure.
    status-bar,
  }

  /// How much attention the reading deserves. The host maps these to its
  /// theme; a guest cannot name a colour, because a guest that could name a
  /// colour would name red and every plugin would be an emergency.
  enum tone {
    normal,
    warn,
    error,
  }

  /// What to show. Every field is advisory: the host truncates, abbreviates
  /// and drops as its own layout requires.
  record reading {
    /// What the reading is. Short — a slot may have room for a dozen
    /// characters and will clip rather than grow.
    label: string,

    /// A proportion in `[0, 1]`, drawn as a bar. `none` draws no bar, which is
    /// the right answer for a reading that is not a proportion.
    ///
    /// Clamped by the host rather than rejected. A plugin that computes 1.02
    /// from a quota that briefly overshoots should draw a full bar, not fail.
    fraction: option<f32>,

    /// One line under or beside the label, as the slot allows: "resets in 54
    /// min", "3 of 8 failing". `none` shows the label alone.
    detail: option<string>,

    /// Shown on hover, where the host has hover. Free to be longer than
    /// `detail` and free to be ignored.
    tooltip: option<string>,

    tone: tone,
  }

  /// A live item, for as long as the handle is held.
  ///
  /// A resource because its lifetime *is* the handle's lifetime: dropping it
  /// removes the item. A guest that traps, unwinds or is torn down cannot
  /// leave a stale reading in the chrome claiming a quota that was last
  /// measured an hour ago — which is worse than showing nothing, because a
  /// number on screen is read as a current number.
  resource item {
    /// Replace what the item shows.
    ///
    /// Fire and forget: no result, so it cannot be awaited and cannot block a
    /// redraw. The host coalesces updates on its own schedule, and a plugin
    /// cannot tell how often it actually repainted — a plugin that could would
    /// tune itself into the frame loop.
    set: func(to: reading);

    /// A manifest-declared command to run when the item is activated, or
    /// `none` for a reading that is not clickable.
    ///
    /// A `command-id` rather than a callback: the command is already declared,
    /// already namespaced by plugin identity and already visible in the
    /// palette, so a click grants nothing that was not granted at install.
    on-activate: func(command: option<command-id>);
  }

  /// Claim a slot.
  ///
  /// Fails when the slot is full, when this plugin already holds as many as
  /// the host allows, or when the host has the chrome hidden. A free function
  /// rather than a constructor because all three of those are ordinary
  /// answers, and a constructor cannot say no.
  claim: func(at: slot) -> result<item, host-error>;
}
